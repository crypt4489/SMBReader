
#define ROUNDED_CORNERS 1
#define BORDERED_CONTAINER 2
#define INVISIBLE_CONTAINER 8

#define DEPTH_BIT_OFFSET 0
#define DEPTH_MAX 7

#define TYPE_BIT_OFFSET 3
#define TYPE_MAX 15

#define TYPE_SPECIFIC_DATA_OFFSET 8
#define TYPE_SPECIFIC_MAX 15

#define CONTAINER_ORIENTATION_DATA_OFFSET 12
#define CONTAINER_ORIENTATION_MAX 1

#define HORIZONTAL_ORIENTATION 0
#define VERTICAL_ORIENTATION 1

#define CLEAR_HOVER_OVER 0
#define HOVER_OVER 1

#define GET_DEPTH(packed) (((packed) >> DEPTH_BIT_OFFSET) & DEPTH_MAX) 
#define GET_TYPE(packed) (((packed) >> TYPE_BIT_OFFSET) & TYPE_MAX) 
#define GET_TYPE_SPECIFIC_DATA(packed) (((packed) >> TYPE_SPECIFIC_DATA_OFFSET) & TYPE_SPECIFIC_MAX)
#define GET_ORIENTATION(packed) (((packed) >> CONTAINER_ORIENTATION_DATA_OFFSET) & CONTAINER_ORIENTATION_MAX)

#define NO_PARENT 4095
#define NOT_A_CHILD 1023

#define PARENT_OFFSET 0
#define MAX_PARENT_INDEX 4095
#define GET_PARENT_INDEX(packed) (((packed) >> PARENT_OFFSET) & MAX_PARENT_INDEX)

#define CHILD_INDEX_OFFSET 12
#define MAX_CHILD_INDEX 1023
#define GET_CHILD_INDEX(packed) (((packed) >> CHILD_INDEX_OFFSET) & MAX_CHILD_INDEX)

#define CHILD_COUNT_OFFSET 22
#define MAX_CHILD_COUNT 1023
#define GET_CHILD_COUNT(packed) (((packed) >> CHILD_COUNT_OFFSET) & MAX_CHILD_COUNT)

#define TEXT_BUFFER_LOCATION_OFFSET 0
#define MAX_TEXT_BUFFER_LOCATION (524287)
#define GET_TEXT_BUFFER_LOCATION(packed) (((packed) >> TEXT_BUFFER_LOCATION_OFFSET) & MAX_TEXT_BUFFER_LOCATION)

#define TEXT_SIZE_OFFSET 19
#define MAX_TEXT_SIZE 4095
#define GET_TEXT_SIZE(packed) (((packed) >> TEXT_SIZE_OFFSET) & MAX_TEXT_SIZE)

#define HAS_TEXT_OFFSET 31
#define GET_HAS_TEXT(packed) (((packed) >> HAS_TEXT_OFFSET) & 1)

struct UIContainer
{
	uvec4 bitfields;  // // x - bitfields y - childIndex/children count/parentCount, z - textData, w - textRenderingInfo  
    vec4 color;
    vec4 padding; //padding top, bottom, left, right
	vec2 relativeContainerSize; // percent size of the canvas
    vec2 structPad;
    uvec4 packedData;
};

struct UIRetainedContainer
{
    vec2 absoluteSize;
    vec2 anchorPoint;
    uvec4 retainedDrawData;
};

struct WindowSize
{
    float width;
    float height;
};

struct UITextVertex
{
	vec2 pos;
	vec2 texCoords;
};

struct FontDataStruct
{
    uint pictureHeight, pictureWidth;
	uint cellWidth, cellHeight;
    uint startingChar;
	uint widthSize;
    uint lettersPerRow;
    uint fontHeight;
};

struct VkDrawIndirectCommand 
{
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};

vec4 makeColorFrom10_11_10_1(uint packedColor)
{
    return vec4(float((packedColor&4290772992U)>>22u), float((packedColor&4192256)>>11u), float((packedColor&2046u)>>1u), float(packedColor&1u)) * vec4(0.000977, 0.000488, 0.000977, 1.0);
}