
#define ROUNDED_CORNERS 1
#define BORDERED_CONTAINER 2
#define INVISIBLE_CONTAINER 8

#define DEPTH_BIT_OFFSET 0
#define DEPTH_MAX 8

#define TYPE_BIT_OFFSET 3
#define TYPE_MAX 16

#define TYPE_SPECIFIC_DATA_OFFSET 8
#define TYPE_SPECIFIC_MAX 16

#define CONTAINER_ORIENTATION_DATA_OFFSET 12
#define CONTAINER_ORIENTATION_MAX 2

#define HORIZONTAL_ORIENTATION 0
#define VERTICAL_ORIENTATION 1

#define CLEAR_HOVER_OVER 0
#define HOVER_OVER 1

#define GET_DEPTH(packed) (((packed) >> DEPTH_BIT_OFFSET) & DEPTH_MAX-1) 
#define GET_TYPE(packed) (((packed) >> TYPE_BIT_OFFSET) & TYPE_MAX-1) 
#define GET_TYPE_SPECIFIC_DATA(packed) (((packed) >> TYPE_SPECIFIC_DATA_OFFSET) & TYPE_SPECIFIC_MAX-1)
#define GET_ORIENTATION(packed) (((packed) >> CONTAINER_ORIENTATION_DATA_OFFSET) & CONTAINER_ORIENTATION_MAX-1)

#define NO_PARENT 4095
#define NOT_A_CHILD 1023

#define PARENT_OFFSET 0
#define MAX_PARENT_INDEX 4096
#define GET_PARENT_INDEX(packed) (((packed) >> PARENT_OFFSET) & MAX_PARENT_INDEX-1)

#define CHILD_INDEX_OFFSET 12
#define MAX_CHILD_INDEX 1024
#define GET_CHILD_INDEX(packed) (((packed) >> CHILD_INDEX_OFFSET) & MAX_CHILD_INDEX-1)

#define CHILD_COUNT_OFFSET 22
#define MAX_CHILD_COUNT 1024
#define GET_CHILD_COUNT(packed) (((packed) >> CHILD_COUNT_OFFSET) & MAX_CHILD_COUNT-1)

#define TEXT_BUFFER_LOCATION_OFFSET 0
#define MAX_TEXT_BUFFER_LOCATION (524288)
#define GET_TEXT_BUFFER_LOCATION(packed) (((packed) >> TEXT_BUFFER_LOCATION_OFFSET) & MAX_TEXT_BUFFER_LOCATION-1)

#define TEXT_SIZE_OFFSET 19
#define MAX_TEXT_SIZE 4096
#define GET_TEXT_SIZE (packed) (((packed) >> TEXT_SIZE_OFFSET) & MAX_TEXT_SIZE-1)

#define HAS_TEXT_OFFSET 31
#define GET_HAS_TEXT(packed) (((packed) >> HAS_TEXT_OFFSET) & 1)

struct UIContainer
{
	uvec4 bitfields;  // x - bitfields y - packed children data z - packed text data 
    vec4 color;
    vec4 padding; //padding top, bottom, left, right
	vec2 relativeContainerSize; // percent size of the canvas
    vec2 structPad;
    uvec4 packedData;
};

struct UIRetainedContainer
{
    vec2 absoluteSize;
    vec2 anchorPoint;
    uvec4 retainedDrawData;
};

struct WindowSize
{
    float width;
    float height;
};

vec4 makeColorFrom10_11_10_1(uint packedColor)
{
    return vec4(float((packedColor&4290772992U)>>22u), float((packedColor&4192256)>>11u), float((packedColor&2046u)>>1u), float(packedColor&1u)) * vec4(0.000977, 0.000488, 0.000977, 1.0);
}